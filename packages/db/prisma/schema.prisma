// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  name             String            @default("")
  username         String            @default("")
  email            String            @unique
  emailVerified    Boolean           @default(false)
  imageUrl         String?
  isAdmin          Boolean           @default(false)
  description      String            @default("")
  location         String            @default("")
  skills           String[]          @default([])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  contestResults   ContestResult[]
  challengeResults ChallengeResult[]
  contests         Contest[]
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  issuer                String    @default("")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Contest {
  id            String         @id @default(uuid())
  title         String
  subtitle      String?
  duration      Int // seconds
  isDeleted     Boolean        @default(false)
  startsAt      DateTime       @db.Timestamptz(3)
  challenges    Challenge[]
  contestResult ContestResult[]
  leaderboardSnapshot ContestLeaderboardSnapshot?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime?
  user          User           @relation(fields: [userId], references: [id])
  userId        String // how do i enforce one more constraint that user can only be admin 
}

model Challenge {
  id              String           @id @default(uuid())
  title           String
  notionLink      String
  testFile        String
  baseGithubUrl   String
  totalTestCases  Int
  contestId       String
  contest         Contest          @relation(fields: [contestId], references: [id])
  challengeResult ChallengeResult[]
}

model ContestResult {
  id      String        @id @default(uuid())
  status  ContestStatus
  score   Int           @default(0)
  penalty Int           @default(0)

  challengeResult ChallengeResult[]
  contestId       String
  contest         Contest           @relation(fields: [contestId], references: [id])
  userId          String
  user            User              @relation(fields: [userId], references: [id])

  @@unique([userId, contestId])
}

model ChallengeResult {
  id                           String @id @default(uuid())
  score                        Int
  penalty                      Int
  duration                     Int
  numberOfFailBefore1stAC      Int
  timeOf1stAcSinceContestStart Int?

  contestResultId String
  contestResult   ContestResult @relation(fields: [contestResultId], references: [id])
  challengeId     String
  challenge       Challenge     @relation(fields: [challengeId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])

  @@unique([userId, challengeId])
}

model SubmissionSession {
  id              String   @id @default(uuid())
  token           String   @unique
  userId          String
  contestId       String
  challengeId     String
  status          String   @default("pending") // pending | processing | completed
  testCasesPassed Int?
  testCasesTotal  Int?
  createdAt       DateTime @default(now())
  expiresAt       DateTime
}

model ContestLeaderboardSnapshot {
  id        String   @id @default(uuid())
  contestId String   @unique
  contest   Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ContestStatus {
  RUNNING
  ENDED
}
